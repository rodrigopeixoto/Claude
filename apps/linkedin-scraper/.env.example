# Port the service listens on
PORT=3002

# Key clients must send in the `x-api-key` header to call this API
SCRAPER_API_KEY=change_me

# Your Apify API token (Apify Console -> Settings -> Integrations)
APIFY_API_TOKEN=

# Default Apify actor ID/name used by POST /linkedin/profiles,
# e.g. an actor from the Apify Store that scrapes LinkedIn profiles.
# Can be overridden per-request via the `actorId` field, or bypassed
# entirely with POST /linkedin/run.
APIFY_LINKEDIN_ACTOR_ID=harvestapi/linkedin-profile-scraper

# Input field name the actor above expects for the list of profile URLs.
# Varies by actor - check the actor's input schema on Apify. Defaults to "profileUrls".
APIFY_PROFILE_URL_FIELD=urls

# Default Apify actor used by POST /linkedin/search (filtered people search,
# no LinkedIn login/cookies required). Can be overridden per-request via `actorId`.
APIFY_SEARCH_ACTOR_ID=harvestapi/linkedin-profile-search

# Default Apify actor used by POST /leads/:id/posts/scrape (recent posts scraper).
APIFY_POSTS_ACTOR_ID=harvestapi/linkedin-profile-posts

# CRM database (SQLite file, created automatically on first run)
DATABASE_URL="file:./dev.db"

# Outreach rate limits and business hours — enforced by the API, not just the UI.
TIMEZONE=America/Sao_Paulo
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
# 0=Sunday .. 6=Saturday
BUSINESS_DAYS=1,2,3,4,5
DAILY_CONNECTION_LIMIT=25
DAILY_MESSAGE_LIMIT=40
DAILY_ACTION_LIMIT=200
CONNECTION_WITHDRAW_DAYS=10
