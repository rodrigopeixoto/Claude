# Postgres. Vazio = banco embutido em ./data/pg (Radar.command / npm run local).
# Com docker compose: postgresql://radar:radar@localhost:5433/radar
DATABASE_URL=

# Classificação por LLM (opcional: sem chave, usa heurística local)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Coletores opcionais
YOUTUBE_API_KEY=
APIFY_TOKEN=

# Alertas: webhook compatível com Slack ({"text": "..."}) — opcional
ALERT_WEBHOOK_URL=

# Protege o dashboard com Basic Auth (usuário: qualquer; senha abaixo). Vazio = aberto.
DASHBOARD_PASSWORD=

# Intervalo do loop do worker em segundos
WORKER_TICK_SECONDS=60

# Leitura estratégica (Claude): modelo e geração automática semanal (on/off)
STRATEGY_MODEL=claude-opus-5-5
STRATEGY_AUTO=on
# Contexto da sua operação usado pela leitura estratégica (opcional)
AGENCY_CONTEXT=
